{
  "manifest_version": 3,
  "name": "Gecko",
  "description": "Automated CSPT discovery tool",
  "version": "1.6.1",
  "action": {
    "default_popup": "popup.html"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "js/sw.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "webRequest",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "48": "icons/gecko-48.png",
    "96": "icons/gecko-96.png"
  }
}